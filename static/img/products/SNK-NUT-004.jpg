<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F3F9F5"/>
      <stop offset="100%" stop-color="#E2EFE7"/>
    </linearGradient>
    <linearGradient id="primaryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#16865B"/>
      <stop offset="100%" stop-color="#0E5A3D"/>
    </linearGradient>
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#16865B" flood-opacity="0.15"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="400" height="400" rx="24" fill="url(#bgGrad)"/>
  <rect x="1" y="1" width="398" height="398" rx="23" fill="none" stroke="#D1E4D9" stroke-width="2"/>

  <!-- Subtle Pattern Circle -->
  <circle cx="200" cy="180" r="100" fill="#E8F4ED" opacity="0.8"/>
  <circle cx="200" cy="180" r="75" fill="#DCEDE3" opacity="0.8"/>

  <!-- Centered Grocery Basket & Leaf Icon -->
  <g transform="translate(130, 110)" filter="url(#softGlow)">
    <!-- Basket Handles -->
    <path d="M 30,55 C 30,15 110,15 110,55" fill="none" stroke="url(#primaryGrad)" stroke-width="6" stroke-linecap="round"/>
    
    <!-- Basket Body -->
    <path d="M 20,55 L 120,55 L 105,120 L 35,120 Z" fill="url(#primaryGrad)"/>
    
    <!-- Basket Weave Accent Lines -->
    <line x1="45" y1="58" x2="45" y2="117" stroke="#ffffff" stroke-width="3" opacity="0.4" stroke-linecap="round"/>
    <line x1="70" y1="58" x2="70" y2="117" stroke="#ffffff" stroke-width="3" opacity="0.4" stroke-linecap="round"/>
    <line x1="95" y1="58" x2="95" y2="117" stroke="#ffffff" stroke-width="3" opacity="0.4" stroke-linecap="round"/>
    
    <!-- Sprouting Organic Leaf -->
    <path d="M 70,55 C 70,25 98,15 110,8 C 110,25 90,48 70,55 Z" fill="#2ECC71"/>
    <path d="M 70,55 C 65,40 50,30 38,25 C 45,40 58,50 70,55 Z" fill="#27AE60"/>
  </g>

  <!-- Brand Typography -->
  <text x="200" y="290" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="20" font-weight="700" fill="#16865B" letter-spacing="0.5">GreenLeaf Nexus</text>
  <text x="200" y="318" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="14" font-weight="500" fill="#6B7280">Farm Fresh &amp; Packaged Goods</text>
</svg>
